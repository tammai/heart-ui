{
  "name": "heart-ui",
  "version": "0.0.11",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    },
    "./nuxt": {
      "import": {
        "default": "./dist/nuxt.js",
        "types": "./dist/nuxt.d.ts"
      }
    },
    "./common/*": {
      "import": {
        "default": "./dist/common/*.js",
        "types": "./dist/common/*.d.ts"
      }
    },
    "./components/*": {
      "import": {
        "default": "./dist/components/*.js",
        "types": "./dist/components/*.vue.d.ts"
      }
    },
    "./composables/*": {
      "import": {
        "default": "./dist/composables/*.js",
        "types": "./dist/composables/*.d.ts"
      }
    }
  },
  "style": "./dist/style.css",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "scripts": {
    "dev": "pnpm run -C playground dev",
    "build": "vite build && vue-tsc",
    "types": "vue-tsc",
    "preview": "pnpm run -C playground preview",
    "release": "changelogen --clean --release && npm publish && git push --follow-tags",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "lodash-unified": "^1.0.3",
    "vue": "^3.3.11"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.8.2",
    "@nuxt/schema": "^3.8.2",
    "@types/node": "^20.10.5",
    "@vitejs/plugin-vue": "^4.5.2",
    "changelogen": "^0.5.5",
    "glob": "^10.3.10",
    "nuxt": "^3.8.2",
    "typescript": "^5.2.2",
    "unocss": "^0.58.0",
    "vite": "^5.0.8",
    "vite-plugin-build": "^0.10.0",
    "vitepress": "1.0.0-rc.32",
    "vue-tsc": "^1.8.25"
  },
  "engines": {
    "node": ">=16"
  }
}
